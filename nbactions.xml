<?xml version="1.0" encoding="UTF-8"?>
<actions>
  <action>
    <actionName>run</actionName>
    <displayName>Run VideoQuiz (Easy Setup)</displayName>
    <packagings><packaging>jar</packaging></packagings>
    <goals><goal>org.codehaus.mojo:exec-maven-plugin:3.5.0:exec</goal></goals>
    <properties>
      <exec.executable>powershell.exe</exec.executable>
      <exec.args>-NoProfile -ExecutionPolicy Bypass -File scripts/start-videoquiz.ps1</exec.args>
      <exec.workingdir>${project.basedir}</exec.workingdir>
    </properties>
  </action>
</actions>
